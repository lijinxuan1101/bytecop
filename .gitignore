# Datasets — keep only Python under data/ (dataset.py, prepare_*.py, transforms.py)
# Trailing slash matches directories only; raw mounts are symlinks, so no slash.
data/datasets/
data/SID_Set_processed/
data/SID_Set_bad_images/
data/cifake_full/
data/cifake_smoke/
data/SID_Set
data/CIFAKE
data/WildFake



# Training runs, checkpoints, TensorBoard logs — ship only the submitted ckpt
runs/*
!runs/spatial_tower/
runs/spatial_tower/*
!runs/spatial_tower/spatial_tower_wildfake/
runs/spatial_tower/spatial_tower_wildfake/*
!runs/spatial_tower/spatial_tower_wildfake/best.pt
experiments/cifake_clip_h_*/
cifake_robustness_results.csv

# DFN-5B and other local weight dumps (not the submitted ckpt)
weights/

# Third-party source clones (installed via pip install -e)
models/open_clip/

